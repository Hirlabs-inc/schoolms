# Server-only environment variables (Next.js keeps these OUT of the browser bundle)
# These are read by server-side code only (lib/turso.ts, lib/auth.ts, app/api/*).
# Do NOT prefix with NEXT_PUBLIC_ — that would expose them to clients.

# libSQL / Turso database connection (server-only)
TURSO_URL=libsql://your-instance.turso.io
TURSO_TOKEN=your-turso-auth-token

# JWT signing secret for auth tokens (server-only, keep secret!)
JWT_SECRET=generate-a-long-random-secret-here

# Public key (safe to expose to the browser)
NEXT_PUBLIC_TEXTBEE_API_KEY=your-textbee-key
