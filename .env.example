# Server-only environment variables (Next.js keeps these OUT of the browser bundle)
# These are read by server-side code only (lib/turso.ts, lib/auth.ts, app/api/*).
# Do NOT prefix with NEXT_PUBLIC_ — that would expose them to clients.

# libSQL / Turso database connection (server-only, used when DATABASE_URL is NOT set)
TURSO_URL=libsql://your-instance.turso.io
TURSO_TOKEN=your-turso-auth-token

# Postgres database connection (server-only). When set, the app uses a locally
# hosted Postgres instead of Turso. Run `npm run db:migrate` first to create the
# schema (scripts/schema.postgres.sql).
# DATABASE_URL=postgresql://openpg:openpgpwd@localhost:5432/school_management

# JWT signing secret for auth tokens (server-only, keep secret!)
JWT_SECRET=generate-a-long-random-secret-here

# Absolute base URL used in password-reset links (e.g. https://school.example.com)
APP_URL=https://your-app-domain

# Optional: HTTP webhook that receives { email, resetUrl } so you can email the
# reset link. Without it, resets are only logged (dev) / silently no-op (prod).
PASSWORD_RESET_WEBHOOK=https://hooks.example.com/password-reset

# SMS provider key (SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_. Used by
# lib/sms.ts from server routes; never exposed to the browser.)
TEXTBEE_API_KEY=your-textbee-key
